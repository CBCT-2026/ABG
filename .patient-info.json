{
  "files": [
    {
      "glob": "content/*-en.html",
      "lang": "en"
    },
    {
      "glob": "content/*-ja.html",
      "lang": "ja"
    },
    {
      "glob": "content/narration.md",
      "lang": "auto"
    },
    {
      "glob": "sheet/en/*/index.html",
      "lang": "en"
    },
    {
      "glob": "sheet/ja/*/index.html",
      "lang": "ja"
    },
    {
      "glob": "study/recruitment-flyer/src/flyer-en.html",
      "lang": "en"
    },
    {
      "glob": "study/recruitment-flyer/src/flyer-ja.html",
      "lang": "ja"
    }
  ],
  "pairs": [
    [
      "content/pre-op-en.html",
      "content/pre-op-ja.html"
    ],
    [
      "content/short-term-en.html",
      "content/short-term-ja.html"
    ],
    [
      "content/long-term-en.html",
      "content/long-term-ja.html"
    ],
    [
      "study/recruitment-flyer/src/flyer-en.html",
      "study/recruitment-flyer/src/flyer-ja.html"
    ]
  ],
  "ignore_selectors": [
    "sup.cite",
    ".refs",
    ".ph",
    ".term"
  ],
  "address_reader": "you",
  "ja_address_reader": "omit",
  "jargon_allow": [
    "AR"
  ],
  "spoken": [
    {
      "glob": "content/narration.md",
      "max_seconds": 60,
      "sections": "^Stage 1 English$"
    },
    {
      "glob": "content/narration.md",
      "max_seconds": 60,
      "sections": "^Stage 1 Japanese$"
    },
    {
      "glob": "content/narration.md",
      "max_seconds": 60,
      "sections": "^Stage 2 English$"
    },
    {
      "glob": "content/narration.md",
      "max_seconds": 60,
      "sections": "^Stage 2 Japanese$"
    },
    {
      "glob": "content/narration.md",
      "max_seconds": 60,
      "sections": "^Stage 3 English$"
    },
    {
      "glob": "content/narration.md",
      "max_seconds": 60,
      "sections": "^Stage 3 Japanese$"
    }
  ],
  "ignore_sections": [
    "^Narration script"
  ]
}
